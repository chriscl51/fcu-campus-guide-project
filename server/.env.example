# Copy this file to .env and fill in real values. .env is gitignored — real
# secrets never get committed. These two only matter the FIRST time you run
# `npm run seed` on a fresh database: they create the one bootstrap admin
# account (see seed.js). After that first login, manage accounts and
# passwords from the admin panel's "帳號管理" tab instead of editing this file.
ADMIN_USERNAME=admin
# If left unset, seed.js generates a random password and prints it once to
# the console — copy it down, it's not stored anywhere in plain text.
ADMIN_PASSWORD=change-me
