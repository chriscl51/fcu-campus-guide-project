# Copy this file to .env and fill in a real value. .env is gitignored — the
# real password never gets committed to source control. Must match
# server/.env's ADMIN_PASSWORD (this one only gates the AdminView.vue login
# screen client-side; the server independently checks its own copy on every
# write request).
#
# NOTE: Vite bakes VITE_-prefixed vars into the built JS bundle at build
# time — this keeps the value out of the git repo, but it is still visible
# to anyone inspecting the built site's source (see AdminView.vue's
# disclaimer: this is a front-end lock, not real access control).
VITE_ADMIN_PASSWORD=change-me
